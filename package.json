{
  "name": "agentfiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node src/server.ts",
    "dev": "node --watch-path=src --watch-preserve-output scripts/dev.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "demo": "npm run build && node src/server.ts --demo"
  },
  "dependencies": {
    "picomatch": "^4.0.3",
    "smol-toml": "^1.4.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "description": "Read-only local configuration discovery for Codex and Pi"
}
